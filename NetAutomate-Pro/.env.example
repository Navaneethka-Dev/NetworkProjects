# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="NetAutomate Pro"
APP_VERSION="1.1.0"
DEBUG=false
ENVIRONMENT=development

# ── Security — CHANGE THESE IN PRODUCTION ─────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_me_in_production_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://netautomate:netautomate@db:5432/netautomate
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Network / Devices ─────────────────────────────────────────────────────────
# Set to false when you have real Cisco/Juniper hardware
MOCK_DEVICES=true
DEVICE_SSH_TIMEOUT=30

# ── CORS — add your production domain ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Backup policy ─────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=90
BACKUP_MAX_PER_DEVICE=50
SCHEDULED_BACKUP_INTERVAL_HOURS=6

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

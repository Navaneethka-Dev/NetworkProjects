{# 
  Cisco Base Configuration Template
  Author: Navaneethraj KA
  
  Variables:
    - device: Device information from inventory
    - domain_name: Domain name for the device
    - ntp_server: NTP server IP
    - logging_server: Syslog server IP
#}

! Base Configuration for {{ device.hostname }}
! Generated by NetAutomate Pro
! Date: {{ timestamp | default('N/A') }}

! Basic Settings
hostname {{ device.hostname }}
ip domain-name {{ domain_name | default('network.local') }}

! Security Settings
service password-encryption
no ip http server
no ip http secure-server

! Enable Secret
enable secret {{ enable_secret | default('Str0ngP@ssw0rd!') }}

! Console and VTY Configuration
line console 0
 logging synchronous
 exec-timeout 10 0
 login local

line vty 0 4
 login local
 transport input ssh
 exec-timeout 10 0

! SSH Configuration
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3

! Logging Configuration
logging buffered 16384
{% if logging_server is defined %}
logging host {{ logging_server }}
{% endif %}
logging trap informational

! NTP Configuration
{% if ntp_server is defined %}
ntp server {{ ntp_server }}
{% else %}
ntp server 0.pool.ntp.org
ntp server 1.pool.ntp.org
{% endif %}

! Banner
banner motd ^
===============================================
       AUTHORIZED ACCESS ONLY
  Unauthorized access is prohibited.
  All activities are monitored and logged.
===============================================
^

! SNMP Configuration
{% if snmp_community is defined %}
snmp-server community {{ snmp_community }} RO
{% endif %}

! End of base configuration

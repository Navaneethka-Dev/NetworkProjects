{#
  Juniper JunOS Base Configuration Template
  Author: Navaneethraj KA

  Variables:
    - device      : Device dict from inventory (hostname, ip, device_type)
    - domain_name : Domain name (default: network.local)
    - ntp_server  : NTP server IP
    - logging_server : Syslog server IP
    - snmp_community : SNMP read-only community string
    - enable_secret  : Root authentication password
#}

/* Juniper JunOS base configuration for {{ device.hostname }} */
/* Generated by NetAutomate Pro — {{ timestamp | default('N/A') }}  */

system {
    host-name {{ device.hostname }};
    domain-name {{ domain_name | default('network.local') }};

    /* Root authentication */
    root-authentication {
        encrypted-password "{{ enable_secret | default('$6$placeholder') }}";
    }

    /* System services — SSH only, no Telnet */
    services {
        ssh {
            root-login deny;
            protocol-version v2;
            max-sessions-per-connection 32;
            connection-limit 10;
        }
        netconf {
            ssh;
        }
    }

    /* Syslog */
    syslog {
        user * {
            any emergency;
        }
        file messages {
            any notice;
            authorization info;
        }
        file interactive-commands {
            interactive-commands any;
        }
{% if logging_server is defined %}
        host {{ logging_server }} {
            any info;
            port 514;
        }
{% endif %}
    }

    /* NTP */
    ntp {
{% if ntp_server is defined %}
        server {{ ntp_server }};
{% else %}
        server 0.pool.ntp.org;
        server 1.pool.ntp.org;
{% endif %}
    }

    /* Login banner */
    login {
        message "WARNING: Authorized access only. All activities are monitored.";
        class operator {
            permissions [ network view ];
        }
    }

    /* Archive config on each commit */
    archival {
        configuration {
            transfer-on-commit;
        }
    }
}

{% if snmp_community is defined %}
/* SNMP configuration */
snmp {
    description "Managed by NetAutomate Pro";
    location "{{ device.hostname }}";
    community {{ snmp_community }} {
        authorization read-only;
    }
    trap-group netautomate {
        version v2;
{% if logging_server is defined %}
        targets {
            {{ logging_server }};
        }
{% endif %}
    }
}
{% endif %}

/* Security hardening */
security {
    ssh-known-hosts;
}

/* End of base configuration for {{ device.hostname }} */

{#
  Access Control List (ACL) Configuration Template
  Author: Navaneethraj KA
  
  Variables:
    - acls: List of ACL definitions
    - interface_acls: Interface to ACL bindings
#}

! Access Control List Configuration
! Generated by NetAutomate Pro

{% for acl in acls %}
{% if acl.type == 'standard' %}
! Standard ACL: {{ acl.name }}
ip access-list standard {{ acl.name }}
{% for rule in acl.rules %}
 {{ rule.action }} {{ rule.source }}{% if rule.wildcard is defined %} {{ rule.wildcard }}{% endif %}

{% endfor %}
!
{% elif acl.type == 'extended' %}
! Extended ACL: {{ acl.name }}
ip access-list extended {{ acl.name }}
{% for rule in acl.rules %}
 {{ rule.action }} {{ rule.protocol }} {{ rule.source }}{% if rule.source_wildcard is defined %} {{ rule.source_wildcard }}{% endif %} {{ rule.destination }}{% if rule.dest_wildcard is defined %} {{ rule.dest_wildcard }}{% endif %}{% if rule.port is defined %} eq {{ rule.port }}{% endif %}{% if rule.log is defined and rule.log %} log{% endif %}

{% endfor %}
!
{% endif %}
{% endfor %}

! Apply ACLs to Interfaces
{% if interface_acls is defined %}
{% for binding in interface_acls %}
interface {{ binding.interface }}
 ip access-group {{ binding.acl_name }} {{ binding.direction }}
!
{% endfor %}
{% endif %}

! Apply ACLs to VTY Lines (Management Access)
{% if vty_acl is defined %}
line vty 0 4
 access-class {{ vty_acl }} in
!
{% endif %}

! End of ACL configuration

{#
  VLAN Configuration Template
  Author: Navaneethraj KA
  
  Variables:
    - vlans: List of VLAN dictionaries with id, name, and optional description
    - interfaces: List of interface configurations
#}

! VLAN Configuration
! Generated by NetAutomate Pro

{% for vlan in vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
{% if vlan.description is defined %}
 ! Description: {{ vlan.description }}
{% endif %}
!
{% endfor %}

! Interface VLAN Assignments
{% if interfaces is defined %}
{% for interface in interfaces %}
interface {{ interface.name }}
{% if interface.mode == 'access' %}
 switchport mode access
 switchport access vlan {{ interface.vlan }}
{% elif interface.mode == 'trunk' %}
 switchport mode trunk
 switchport trunk allowed vlan {{ interface.allowed_vlans | default('all') }}
{% if interface.native_vlan is defined %}
 switchport trunk native vlan {{ interface.native_vlan }}
{% endif %}
{% endif %}
{% if interface.description is defined %}
 description {{ interface.description }}
{% endif %}
 no shutdown
!
{% endfor %}
{% endif %}

! SVI Configuration (Layer 3 VLAN Interfaces)
{% if svi_interfaces is defined %}
{% for svi in svi_interfaces %}
interface vlan {{ svi.vlan_id }}
 ip address {{ svi.ip_address }} {{ svi.subnet_mask }}
{% if svi.description is defined %}
 description {{ svi.description }}
{% endif %}
 no shutdown
!
{% endfor %}
{% endif %}

! End of VLAN configuration
